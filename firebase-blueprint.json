{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile settings and financial preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "currency": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "currency"]
    },
    "MonthlyBudget": {
      "title": "MonthlyBudget",
      "description": "Budget settings and planned targets for a specific month (YYYY-MM)",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "month": { "type": "string", "maxLength": 7, "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "plannedExpenses": { "type": "number" },
        "plannedIncomes": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "month"]
    },
    "CategoryBudget": {
      "title": "CategoryBudget",
      "description": "Planned budget per category for a month",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "month": { "type": "string", "maxLength": 7 },
        "name": { "type": "string", "maxLength": 60 },
        "type": { "type": "string", "enum": ["despesa", "receita"] },
        "ruleGroup": { "type": "string", "enum": ["necessidades", "desejos", "investimentos", "receitas"] },
        "plannedAmount": { "type": "number" },
        "color": { "type": "string", "maxLength": 20 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "month", "name", "type", "plannedAmount"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial income or expense transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "month": { "type": "string", "maxLength": 7, "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "date": { "type": "string", "maxLength": 10 },
        "description": { "type": "string", "maxLength": 120 },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["despesa", "receita"] },
        "category": { "type": "string", "maxLength": 60 },
        "ruleGroup": { "type": "string", "enum": ["necessidades", "desejos", "investimentos", "receitas"] },
        "status": { "type": "string", "enum": ["concluido", "pendente"] },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 250 },
        "isRecurring": { "type": "boolean" },
        "recurrenceInterval": { "type": "string", "maxLength": 20 },
        "installmentCurrent": { "type": "number" },
        "installmentTotal": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "month", "date", "description", "amount", "type", "category"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User private profile document"
    },
    "/users/{userId}/budgets/{monthId}": {
      "schema": "MonthlyBudget",
      "description": "Monthly budget targets by month ID (e.g. 2026-11)"
    },
    "/users/{userId}/budgets/{monthId}/categories/{categoryId}": {
      "schema": "CategoryBudget",
      "description": "Category budget plans for the specified month"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Individual transactions for the user"
    }
  }
}
